# ---- Papa's Toys backend configuration ----
# Copy this file to `.env` (or set these as real environment variables) and fill in.

# Port the server listens on
PORT=8080

# Firebase project that owns your user accounts (the same project whose
# web API key goes in the extension's c.js). Required for token verification.
FIREBASE_PROJECT_ID=your-firebase-project-id

# The Firebase WEB config the admin dashboard uses to sign users in (browser
# side). apiKey here is the same public web API key that goes in the extension's
# c.js. authDomain defaults to <projectId>.firebaseapp.com if left blank.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# How the server verifies incoming Firebase ID tokens.
#   - Leave GOOGLE_APPLICATION_CREDENTIALS unset to verify tokens against
#     Google's public certs using only FIREBASE_PROJECT_ID (fine for most cases).
#   - Set it to a service-account JSON path if you also want admin privileges
#     (e.g. listing users). Optional.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Where the SQLite database file lives.
# On Railway, attach a Volume and mount it at /data, then set DB_PATH=/data/papas-toys.db
# so your records survive redeploys. Locally, ./data is fine.
DB_PATH=/data/papas-toys.db

# ---- Geocoding ----
# Default provider is OpenStreetMap Nominatim (free, no key, ~1 req/sec).
# Nominatim's usage policy REQUIRES a real contact email in the User-Agent.
GEOCODE_USER_AGENT=papas-toys/1.0 (you@example.com)

# Optional Google Geocoding API key. If set, it is used as the "googleFallback"
# when the extension requests it (and can be made the primary provider below).
# GOOGLE_MAPS_API_KEY=

# Primary geocoding provider: "nominatim" (default) or "google".
GEOCODE_PROVIDER=nominatim

# Max geocode failures before a record stops being retried automatically.
GEOCODE_MAX_FAILS=5
